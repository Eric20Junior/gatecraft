# Dependencies (there are none at runtime, but dev tooling and npx leave these)
node_modules/
package-lock.json

# Build and publish artifacts
*.tgz
dist/
coverage/
.nyc_output/

# Test scratch space
test/tmp/
test/fixtures/**/.ai/
test/fixtures/**/AGENTS.md

# Editor and OS noise
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/*
!.vscode/extensions.json

# Logs
*.log
npm-debug.log*

# Local environment
.env
.env.*
!.env.example

# This repository *is* gatecraft, and it now runs on itself. The framework kernel
# under .ai/ stays ignored — payload/ is its source of truth and a committed copy
# would only drift from it. Project-owned files are committed, per --share below.

# >>> gatecraft >>>
# Managed by gatecraft. Remove with: gatecraft uninstall
# The framework itself is machine-generated — reinstall it with `npx gatecraft init`.
.ai/*
.ai/checklists/
.ai/evaluation/
.ai/metrics/
.ai/planning/
.ai/prompts/
.ai/research/
.ai/reviews/
.ai/standards/
.ai/templates/
.ai/workflows/

# Project knowledge is shared: context, decisions, memory, architecture.
!.ai/PROJECT_CONTEXT.md
!.ai/DECISIONS.md
!.ai/memory/
!.ai/architecture/
!.ai/.gatecraft-manifest.json
# <<< gatecraft <<<
